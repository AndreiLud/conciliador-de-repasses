# Local language model settings. The model runs on your machine: there is no API key.
# Copy to .env and adjust. Never commit .env.

# llamacpp: any OpenAI compatible local server (llama.cpp llama-server, LM Studio)
# ollama:   Ollama server
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://127.0.0.1:8080

# Name sent to the server. Keep the default to replay llm_cache/ exactly;
# with Ollama use the tag you pulled, for example qwen3.5:2b.
LLM_MODEL=qwen3.5-2b-q4_k_m

# cache_first: answer from llm_cache/ and call the server only on a miss
# offline:     never call a server (same as python run_all.py --offline)
# live:        always call the server and refresh the cache
LLM_MODE=cache_first
LLM_TIMEOUT=600

# Weekly summary: numbers always come from the code. SUMMARY_AI=1 adds a short reading
# written by the model (off by default: the 2B model stated wrong facts in the test).
SUMMARY_AI=0

# Letters: table, amounts and next step always come from the code. LETTERS_AI=1 lets the model write the
# explanation paragraph (off by default: in a review of 20 letters by the 2B model, 12 had a wrong fact).
LETTERS_AI=0

# Legacy statement lines with more than one hypothesis: the rule decides and the model runs in shadow
# mode for the evaluation (the rule was right in every test case, the model was not). LINES_AI=1 lets the
# model decide, with disagreements sent to review.
LINES_AI=0

# Public address of the GitHub Pages site, used for the Open Graph tags (python -m src.export.check_texts).
# Change it only if you publish the site somewhere else.
SITE_URL=https://andreilud.github.io/conciliador-de-repasses
